# Family Tree Service Configuration Example
# Скопируйте этот файл в .env и настройте параметры по своему усмотрению

# ── База данных ─────────────────────────────────────────────────────────────
FAMILY_TREE_DATABASE_URL=sqlite:///./family_tree.db

# ── Медиа файлы ───────────────────────────────────────────────────────────────
FAMILY_TREE_MEDIA_DIR=media
FAMILY_TREE_OBSIDIAN_EXPORT_DIR=export/obsidian

# ── JWT Аутентификация (ОБЯЗАТЕЛЬНО для продакшена) ───────────────────────────
# Секретный ключ для токенов - ГЕНЕРИРУЙТЕ СВОЙ!
# Пример: python -c "import secrets; print(secrets.token_urlsafe(32))"
FAMILY_TREE_JWT_SECRET_KEY=CHANGE-ME-TO-SECURE-RANDOM-STRING-AT-32-CHARS-MIN
FAMILY_TREE_JWT_ALGORITHM=HS256
FAMILY_TREE_JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# ── Токены авторизации (ОБЯЗАТЕЛЬНО измените для продакшена) ────────────────────
# Минимум 12 символов, лучше 24+. Используйте разные значения!
# Пример: FAMILY_TREE_VIEW_TOKEN=$(openssl rand -base64 18)
FAMILY_TREE_VIEW_TOKEN=change-me-view-token-min-12-chars
FAMILY_TREE_EDIT_TOKEN=change-me-edit-token-min-12-chars

# ── Безопасность ───────────────────────────────────────────────────────────────
# Включить rate limiting (защита от перебора)
FAMILY_TREE_ENABLE_RATE_LIMITING=true
# Включить brute-force временную блокировку (3 попытки, 5 мин бана)
FAMILY_TREE_ENABLE_BRUTE_FORCE_PROTECTION=true
# Добавить security headers к ответам
FAMILY_TREE_ENABLE_SECURITY_HEADERS=true
# Требовать JWT для доступа к /docs и /openapi.json
FAMILY_TREE_PROTECT_API_DOCS=true
# CORS origins (через запятую) - УКАЖИТЕ ВАШИ DOMAINS!
FAMILY_TREE_ALLOW_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Логирование ───────────────────────────────────────────────────────────────
FAMILY_TREE_LOG_LEVEL=INFO
# Возможные значения: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ── Приложение ────────────────────────────────────────────────────────────────
FAMILY_TREE_APP_NAME=Family Tree Service
FAMILY_TREE_MAX_TREE_DEPTH=20

# ── Сервер (для скриптов запуска) ────────────────────────────────────────────
FAMILY_TREE_HOST=0.0.0.0
FAMILY_TREE_PORT=8000

# ── Примеры для production окружения ─────────────────────────────────────────
# FAMILY_TREE_JWT_SECRET_KEY=$(openssl rand -base64 48)
# FAMILY_TREE_VIEW_TOKEN=$(openssl rand -base64 24)
# FAMILY_TREE_EDIT_TOKEN=$(openssl rand -base64 24)
# FAMILY_TREE_LOG_LEVEL=WARNING
# FAMILY_TREE_ALLOW_CORS_ORIGINS=https://yourdomain.com
