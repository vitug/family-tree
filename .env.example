# Family Tree Service Configuration Example
# Скопируйте этот файл в .env и настройте параметры по своему усмотрению

# База данных
FAMILY_TREE_DATABASE_URL=sqlite:///./family_tree.db

# Медиа файлы
FAMILY_TREE_MEDIA_DIR=media
FAMILY_TREE_OBSIDIAN_EXPORT_DIR=export/obsidian

# JWT Аутентификация (РЕКОМЕНДУЕТСЯ НАСТРОИТЬ)
# Секретный ключ для токенов - ГЕНЕРИРУЙТЕ СВОЙ!
# Пример генерации в Python: python -c "import secrets; print(secrets.token_urlsafe(32))"
FAMILY_TREE_JWT_SECRET_KEY=your-secret-key-here-change-this-in-production
FAMILY_TREE_JWT_ALGORITHM=HS256
FAMILY_TREE_JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Legacy Edit Token (для обратной совместимости)
# Рекомендуется использовать JWT вместо этого
FAMILY_TREE_EDIT_TOKEN=secret

# Логирование
FAMILY_TREE_LOG_LEVEL=INFO
# Возможные значения: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Приложение
FAMILY_TREE_APP_NAME=Family Tree Service
FAMILY_TREE_MAX_TREE_DEPTH=20

# Сервер (для скриптов запуска)
FAMILY_TREE_HOST=0.0.0.0
FAMILY_TREE_PORT=8000

# Примеры для production окружения:
# FAMILY_TREE_JWT_SECRET_KEY=$(openssl rand -base64 32)
# FAMILY_TREE_LOG_LEVEL=WARNING
# FAMILY_TREE_EDIT_TOKEN=$(openssl rand -base64 16)
